# Example .env for `frontend` (do NOT commit real secrets)
# Copy to `frontend/.env` and fill in real values for local development.

VITE_BASE_URL=https://your-api-url.example.com
VITE_SOME_PUBLIC_KEY=your_public_key

# Set to `true` to bypass Cognito/Google auth locally for screenshots/demo.
# This will create a reversible mock user in the frontend only.
# VITE_BYPASS_AUTH=true
