### Example .env for `server` (do NOT commit real secrets)
# Copy to `.env` and fill in real values for local development.

# Twilio credentials
TWILIO_SID=your_twilio_sid
TWILIO_AUTH=your_twilio_auth
TWILIO_PHONE=+1234567890

# Gemini / Google token
GEMINI_TOKEN=your_gemini_token

# Public URL for your application
PUBLIC_URL=https://your-public-url.ngrok-free.app

# MongoDB connection URI
MONGO_URI="mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/CallingAgent?retryWrites=true&w=majority"

# LemonFox API key
LEMON_FOX_API_KEY=your_lemonfox_api_key

# AWS credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id
